{
  "$defs": {
    "signature": {
      "properties": {
        "algorithm": {
          "const": "Ed25519",
          "type": "string"
        },
        "public_key": {
          "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]{10,}$",
          "type": "string"
        },
        "signature": {
          "pattern": "^u[A-Za-z0-9_-]{86}$",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "public_key",
        "signature"
      ],
      "type": "object"
    }
  },
  "$id": "https://example.org/oar/schema/0.3/revocation.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "id": {
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "type": "string"
    },
    "issued": {
      "format": "date",
      "type": "string"
    },
    "reason": {
      "maxLength": 280,
      "minLength": 1,
      "type": "string"
    },
    "reason_code": {
      "enum": [
        "ISSUED_IN_ERROR",
        "FRAUDULENT",
        "TASK_DISPUTED",
        "OTHER"
      ],
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "type": "string"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    },
    "spec_version": {
      "const": "0.3",
      "type": "string"
    }
  },
  "required": [
    "id",
    "spec_version",
    "receipt_id",
    "reason_code",
    "reason",
    "issued",
    "signature"
  ],
  "title": "Open Agent Reputation \u2014 Revocation (v0.3)",
  "type": "object"
}
